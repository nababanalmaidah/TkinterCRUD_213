import sqlite3
import tkinter as tk
from tkinter import messagebox

# STEP 1: Membuat koneksi ke database SQLite
conn = sqlite3.connect("nilai_siswa.db")
cursor = conn.cursor()

# STEP 2: Membuat tabel nilai_siswa
cursor.execute("""
CREATE TABLE IF NOT EXISTS nilai_siswa (
    nama_siswa TEXT NOT NULL,
    biologi REAL NOT NULL,
    fisika REAL NOT NULL,
    inggris REAL NOT NULL,
    prediksi_fakultas TEXT NOT NULL
)
""")
conn.commit()
conn.close()


# STEP 3: Membuat fungsi prediksi fakultas
def prediksi_fakultas(biologi, fisika, inggris):
    nilai_tertinggi = max(biologi, fisika, inggris)

    if [biologi, fisika, inggris].count(nilai_tertinggi) > 1:
        return "Nilai seri"
    elif biologi == nilai_tertinggi:
        return "Kedokteran"
    elif fisika == nilai_tertinggi:
        return "Teknik"
    else:
        return "Bahasa"


