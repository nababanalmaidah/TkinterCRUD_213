import sqlite3
import tkinter as tk
from tkinter import messagebox

# STEP 1: Membuat koneksi ke database SQLite
conn = sqlite3.connect("nilai_siswa.db")
cursor = conn.cursor()

# STEP 2: Membuat tabel nilai_siswa
cursor.execute("""
CREATE TABLE IF NOT EXISTS nilai_siswa (
    nama_siswa TEXT NOT NULL,
    biologi REAL NOT NULL,
    fisika REAL NOT NULL,
    inggris REAL NOT NULL,
    prediksi_fakultas TEXT NOT NULL
)
""")
conn.commit()
conn.close()


# STEP 3: Membuat fungsi prediksi fakultas
def prediksi_fakultas(biologi, fisika, inggris):
    nilai_tertinggi = max(biologi, fisika, inggris)

    if [biologi, fisika, inggris].count(nilai_tertinggi) > 1:
        return "Nilai seri"
    elif biologi == nilai_tertinggi:
        return "Kedokteran"
    elif fisika == nilai_tertinggi:
        return "Teknik"
    else:
        return "Bahasa"


# STEP 4: Membuat fungsi submit nilai
def submit_nilai():
    nama = entry_nama.get().strip()

    if not nama:
        messagebox.showwarning(
            "Peringatan", "Nama siswa harus diisi!"
        )
        return

    try:
        biologi = float(entry_biologi.get())
        fisika = float(entry_fisika.get())
        inggris = float(entry_inggris.get())
    except ValueError:
        messagebox.showwarning(
            "Peringatan", "Semua nilai harus berupa angka!"
        )
        return

    # Memastikan nilai berada pada rentang 0-100
    if any(
        nilai < 0 or nilai > 100
        for nilai in (biologi, fisika, inggris)
    ):
        messagebox.showwarning(
            "Peringatan", "Nilai harus antara 0 sampai 100!"
        )
        return

    # Menentukan prediksi berdasarkan nilai tertinggi
    prediksi = prediksi_fakultas(
        biologi, fisika, inggris
    )

    if prediksi == "Nilai seri":
        messagebox.showwarning(
            "Peringatan",
            "Nilai tertinggi sama. Silakan periksa nilai kembali."
        )
        return

    # STEP 5: Menyimpan data ke database SQLite
    conn = sqlite3.connect("nilai_siswa.db")
    cursor = conn.cursor()

    cursor.execute("""
        INSERT INTO nilai_siswa
        (nama_siswa, biologi, fisika, inggris, prediksi_fakultas)
        VALUES (?, ?, ?, ?, ?)
    """, (nama, biologi, fisika, inggris, prediksi))

    conn.commit()
    conn.close()

    # Menampilkan hasil prediksi
    label_hasil.config(
        text="Prediksi Fakultas: " + prediksi
    )

    messagebox.showinfo(
        "Berhasil",
        "Nilai berhasil disimpan!\nPrediksi: " + prediksi
    )

    # Mengosongkan input setelah berhasil
    entry_nama.delete(0, tk.END)
    entry_biologi.delete(0, tk.END)
    entry_fisika.delete(0, tk.END)
    entry_inggris.delete(0, tk.END)
    entry_nama.focus()


# STEP 6: Membuat tampilan Tkinter
root = tk.Tk()
root.title("Prediksi Fakultas Siswa")
root.resizable(False, False)

tk.Label(
    root,
    text="PREDIKSI FAKULTAS SISWA",
    font=("Arial", 14, "bold")
).grid(row=0, column=0, columnspan=2, pady=12)

# Entry nama siswa
tk.Label(root, text="Nama Siswa").grid(
    row=1, column=0, padx=10, pady=5, sticky="w"
)
entry_nama = tk.Entry(root, width=30)
entry_nama.grid(row=1, column=1, padx=10, pady=5)

# Entry nilai Biologi
tk.Label(root, text="Nilai Biologi").grid(
    row=2, column=0, padx=10, pady=5, sticky="w"
)
entry_biologi = tk.Entry(root, width=30)
entry_biologi.grid(row=2, column=1, padx=10, pady=5)

# Entry nilai Fisika
tk.Label(root, text="Nilai Fisika").grid(
    row=3, column=0, padx=10, pady=5, sticky="w"
)
entry_fisika = tk.Entry(root, width=30)
entry_fisika.grid(row=3, column=1, padx=10, pady=5)

# Entry nilai Inggris
tk.Label(root, text="Nilai Inggris").grid(
    row=4, column=0, padx=10, pady=5, sticky="w"
)
entry_inggris = tk.Entry(root, width=30)
entry_inggris.grid(row=4, column=1, padx=10, pady=5)

# STEP 7: Membuat tombol submit nilai
tk.Button(
    root,
    text="Submit Nilai",
    command=submit_nilai,
    width=20
).grid(row=5, column=0, columnspan=2, pady=12)

# Label hasil prediksi
label_hasil = tk.Label(
    root,
    text="Prediksi Fakultas: -",
    font=("Arial", 11, "bold")
)
label_hasil.grid(row=6, column=0, columnspan=2, pady=8)

# STEP 8: Menjalankan aplikasi
root.mainloop()